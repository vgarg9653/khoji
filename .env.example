# ════════════════════════════════════════════════════════════════════════
#  Khoji.AI — environment template
#
#  HOW TO USE
#    1. cp .env.example .env
#    2. Fill in the values below (each one says where to get it)
#    3. Never commit .env — .gitignore already blocks it
#
#  Check what you still need at any time:   ./deploy/setup_secrets.sh --check
# ════════════════════════════════════════════════════════════════════════


# ── 1. LANGUAGE MODEL ───────────────────────────────────────────────────
# Powers: Hindi/Hinglish understanding, voice-note transcription, translation.
# The bot RUNS WITHOUT THIS — it falls back to English + numbered menus.
#
# Pick ONE provider. OpenRouter lets you swap models by editing LLM_MODEL,
# with no code change and no vendor lock-in. Gemini direct is cheaper if you
# are spending Google credits.

# Values: openrouter | gemini | none
LLM_PROVIDER=openrouter

# --- Option A: OpenRouter (recommended — one key, any model) -------------
# Get it: https://openrouter.ai/keys  (sign in → Create Key)
# Cost:   pay-as-you-go, no minimum. Gemini Flash ≈ ₹0.01 per conversation.
# Models: https://openrouter.ai/models — needs an [audio] model for voice.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# --- Option B: Gemini direct (use your Google credits) -------------------
# Get it: https://aistudio.google.com/apikey  (Create API key)
# Cost:   generous free tier.
# Then set LLM_PROVIDER=gemini and LLM_MODEL=gemini-2.5-flash

# ── 1b. WHICH MODEL DOES WHICH JOB (Gemini only) ────────────────────────
# Leave LLM_MODEL unset. It pins every role to one model, and one model doing
# every job means one 429 takes Hindi, voice notes and free-form answers down
# together — which is exactly how this bot was found in production.
#
# MODEL_FALLBACK must be a DIFFERENT family: a free-tier quota is per model,
# so falling back is capacity you already have, not a downgrade.
MODEL_ROUTER=gemini-3.5-flash-lite        # classify, extract, route
MODEL_GENERATION=gemini-3.5-flash-lite    # translate, answer from a record
MODEL_AUDIO=gemini-3.5-flash-lite         # voice notes
MODEL_FALLBACK=gemini-3.1-flash-lite      # on 429/404, a second quota bucket

GEMINI_API_KEY=


# ── 2. WHATSAPP ─────────────────────────────────────────────────────────
# Two ways to connect. The bot serves BOTH webhooks, so you can start on
# Twilio today and move to Meta later by changing this one line.
#
# Values: twilio | meta
WHATSAPP_PROVIDER=meta

# --- Option A: Meta Cloud API (RECOMMENDED — genuinely free) -------------
# Conversations the student starts have been free and unlimited since Nov 2024,
# and Khoji.AI only ever replies. No middleman, no licence fee, official API.
# Blocked only if your business portfolio is unverified/restricted.
# Get these: https://developers.facebook.com/apps → your app → WhatsApp →
#            API Setup.  Full walkthrough: WALKTHROUGH.md steps 2-5.
# Cost:      free for conversations the student starts.

# The "Phone number ID" on the API Setup page — a number, NOT your phone number.
META_PHONE_NUMBER_ID=

# The access token. The temporary one expires in 24h; WALKTHROUGH.md step 14
# shows how to make a permanent one.
META_ACCESS_TOKEN=

# YOU INVENT THIS ONE. Any random string. Paste the SAME value into Meta's
# webhook config so the two sides can recognise each other.
# Generate a good one:  openssl rand -hex 16
META_VERIFY_TOKEN=


# ── 3. GOOGLE CLOUD (only when deploying) ───────────────────────────────
# Not needed to run locally. See WALKTHROUGH.md part D.
GOOGLE_CLOUD_PROJECT=
# true in production, false locally
USE_FIRESTORE=false
# Mumbai — closest to users in India
REGION=asia-south1


# ── 4. PRIVACY ──────────────────────────────────────────────────────────
# A random secret used to hash WhatsApp numbers before storing them, so the
# database never holds a readable phone number.
# Generate:  openssl rand -hex 32
# WARNING: changing this makes every existing session unreadable.
PHONE_HASH_SALT=

# How long an abandoned conversation is kept before deletion.
SESSION_TTL_HOURS=48


# --- Option B: Twilio (fallback only) ------------------------------------
# A reseller on top of the same Meta API. Useful ONLY if Meta has restricted
# your business and you cannot wait. Adds a per-message fee to messages Meta
# gives away free, so do not use it by default.
# Get it: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=


# ── 5. OPTIONAL ─────────────────────────────────────────────────────────
# Path to the scholarship dataset (defaults to deliverables/dataset/).
KHOJI_DATA=
